@startuml
hide circle
skinparam linetype ortho

entity "Средство_наблюдения" as tool {
  * id_средства <<PK>>
  --
  тип_средства
  зона_обзора
  чувствительность
  режим_работы
  статус
}
entity "Журнал_обслуживания" as maint {
  * id_записи <<PK>>
  --
  дата_начала_простоя
  дата_окончания_простоя
  причина
  количество_потерянных_сеансов
  id_средства <<FK>>
}
entity "Сеанс_наблюдения" as session {
  * id_сеанса <<PK>>
  --
  дата_время
  полученные_данные
  результат_обработки
  id_средства <<FK>>
  каталожный_номер <<FK>>
}
entity "Космический_объект" as obj {
  * каталожный_номер <<PK>>
  --
  международный_идентификатор
  тип_объекта
  размерная_оценка
  орбитальные_элементы
  статус
  дата_последнего_наблюдения
}
entity "Прогноз_движения" as forecast {
  * id_прогноза <<PK>>
  --
  орбитальные_элементы
  временной_горизонт
  дата_расчёта
  каталожный_номер <<FK>>
}
entity "Опасное_сближение" as conj {
  * id_сближения <<PK>>
  --
  время_сближения
  минимальное_расстояние
  вероятность_столкновения
  статус
}
entity "Участник_сближения" as part {
  * id_сближения <<PK,FK>>
  * каталожный_номер <<PK,FK>>
}
entity "Владелец_спутника" as owner {
  * id_владельца <<PK>>
  --
  наименование_организации
  контактные_данные
}
entity "Уведомление" as notice {
  * id_уведомления <<PK>>
  --
  рекомендация_по_маневру
  дата_отправки
  id_сближения <<FK>>
  id_владельца <<FK>>
}
entity "Реакция_владельца" as react {
  * id_реакции <<PK>>
  --
  тип_реакции
  дата_фиксации
  id_уведомления <<FK>>
}

tool ||--o{ maint : обслуживается
tool ||--o{ session : используется в
obj ||--o{ session : наблюдается в
obj ||--o{ forecast : имеет прогноз
conj ||--|{ part : включает
obj ||--o{ part : участвует в
conj ||--o{ notice : порождает
owner ||--o{ notice : получает
notice ||--o| react : имеет реакцию
@enduml
